{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/proxy/(.*)",
      "destination": "https://api.anychat.one/public/v1/$1"
    },
    {
      "source": "/api/storage/(.*)",
      "destination": "https://api.anychat.one/storage/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
